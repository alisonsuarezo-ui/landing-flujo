# ===========================================================================
# Campuslands AI Academy · Reto 4 — variables de entorno
# El proyecto arranca SIN .env (valores locales por defecto). Para usar claves
# propias, copia este archivo como .env o ejecuta ./scripts/generar-env.sh
# (Windows: scripts\generar-env.ps1), que genera secretos aleatorios.
# Cambiar un valor y ejecutar `docker compose up -d` lo aplica sin perder datos.
# El archivo .env NUNCA se sube al repositorio.
# ===========================================================================

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=campuslands_leads
POSTGRES_USER=campuslands
# Vacía = campuslands_local (solo para uso local). Si la cambias, se sincroniza al reiniciar.
POSTGRES_PASSWORD=

# --- Backend (Spring Boot) ---------------------------------------------------
# Mínimo 32 caracteres. Firma los JWT del panel. Ej.: openssl rand -base64 48
# Vacía = se genera una aleatoria en cada arranque (las sesiones se cierran al reiniciar).
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480
# Administrador del panel (contraseña guardada con BCrypt).
ADMIN_EMAIL=admin@campuslands.com
ADMIN_NAME=Administrador AI Academy
# Mínimo 8 caracteres. Vacía = se genera una y se muestra en el log:
#   docker compose logs backend | grep -A3 CONTRASE
# Si la cambias aquí, se aplica al reiniciar el backend.
ADMIN_PASSWORD=
# URL pública del sitio: se usa en el enlace del mensaje de Telegram hacia el panel.
PUBLIC_BASE_URL=http://localhost:8080
# Orígenes extra permitidos por CORS (solo para desarrollo con `npm run dev`).
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:8080
APP_TIMEZONE=America/Bogota

# --- n8n -----------------------------------------------------------------------
# Recomendado dejarla vacía: n8n genera su clave y la guarda en el volumen n8n_data.
# Si la defines antes del primer arranque, no la cambies después.
N8N_ENCRYPTION_KEY=
# Webhook de producción del workflow (red interna de Docker).
N8N_WEBHOOK_URL=http://n8n:5678/webhook/campuslands-nuevo-interesado
# Secreto compartido backend ↔ n8n (encabezado X-Webhook-Secret). Recomendado. Ej.: openssl rand -hex 24
N8N_WEBHOOK_SECRET=
# URL con la que abres el editor de n8n en el navegador.
N8N_PUBLIC_URL=http://localhost:5678/
# true = importa y activa n8n/workflows/*.json en cada arranque.
N8N_AUTO_IMPORT=true

# --- Telegram (los proporcionas tú: ver README › Telegram) ---------------------
# Token que entrega @BotFather, con el formato 123456789:AA...
TELEGRAM_BOT_TOKEN=
# ID del chat, grupo o canal que recibe los avisos (ej. 123456789 o -1001234567890).
TELEGRAM_CHAT_ID=
# URL de la Bot API. Déjala así salvo que uses un servidor propio de la Bot API.
TELEGRAM_API_URL=https://api.telegram.org

# --- Puertos publicados en tu máquina -------------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=8081
N8N_PORT=5678
POSTGRES_HOST_PORT=5433

# --- Opcional ---------------------------------------------------------------
# Mirror de Maven para compilar el backend en redes con restricciones.
# Ej.: https://maven-central.storage-download.googleapis.com/maven2/
MAVEN_MIRROR_URL=
